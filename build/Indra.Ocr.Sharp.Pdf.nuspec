<?xml version="1.0" encoding="utf-8"?>
<!-- The manifest of Bluefire.Indra.Ocr.Sharp.Pdf, the Indra.Ocr.Pdf project (docs/340-nuget-packages.md).
     See Indra.Ocr.Sharp.Core.nuspec for what the tokens, the base path and the explicit <files> list
     are about; the two extra entries on the netstandard2.0 group are this project's own BCL use. -->
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Bluefire.Indra.Ocr.Sharp.Pdf</id>
    <version>$packageVersion$</version>
    <title>Indra.Ocr.Sharp.Pdf</title>
    <authors>cnbluefire</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">Apache-2.0</license>
    <projectUrl>https://github.com/cnbluefire/indra-ocr-sharp</projectUrl>
    <repository type="git" url="https://github.com/cnbluefire/indra-ocr-sharp.git" />
    <summary>The PDF decoder of indra-ocr's C# port.</summary>
    <description>The PDF half of the C# indra-ocr port's document.convert: it rasterises PDF pages and
reads their text layer through PDFium, handing Indra.Ocr.Core grayscale pixels (PDFium renders
straight to 8-bit gray). PDFium itself comes from the native bblanchon.PDFium.* packages, which this
package depends on; this package binds it directly and ships no native binary of its own.</description>
    <tags>ocr;indra-ocr;pdf;pdfium;text-layer</tags>
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Bluefire.Indra.Ocr.Sharp.Core" version="[$packageVersion$]" />
        <dependency id="bblanchon.PDFium.Linux" version="156.0.8076" />
        <dependency id="bblanchon.PDFium.Win32" version="156.0.8076" />
        <dependency id="bblanchon.PDFium.macOS" version="156.0.8076" />
      </group>
      <group targetFramework="netstandard2.0">
        <dependency id="Bluefire.Indra.Ocr.Sharp.Core" version="[$packageVersion$]" />
        <dependency id="bblanchon.PDFium.Linux" version="156.0.8076" />
        <dependency id="bblanchon.PDFium.Win32" version="156.0.8076" />
        <dependency id="bblanchon.PDFium.macOS" version="156.0.8076" />
        <dependency id="System.Memory" version="4.5.5" />
        <dependency id="System.Runtime.CompilerServices.Unsafe" version="6.0.0" />
      </group>
    </dependencies>
  </metadata>
  <!-- Every entry is named on purpose (a wildcard would pick up Indra.Ocr.Core.dll, which the
       ProjectReference copies into this project's output); the .pdb entries feed the symbols package,
       see Indra.Ocr.Sharp.Core.nuspec. -->
  <files>
    <file src="..\src\Indra.Ocr.Pdf\bin\$configuration$\net10.0\Indra.Ocr.Pdf.dll" target="lib\net10.0" />
    <file src="..\src\Indra.Ocr.Pdf\bin\$configuration$\net10.0\Indra.Ocr.Pdf.pdb" target="lib\net10.0" />
    <file src="..\src\Indra.Ocr.Pdf\bin\$configuration$\netstandard2.0\Indra.Ocr.Pdf.dll" target="lib\netstandard2.0" />
    <file src="..\src\Indra.Ocr.Pdf\bin\$configuration$\netstandard2.0\Indra.Ocr.Pdf.pdb" target="lib\netstandard2.0" />
    <file src="..\LICENSE" target="LICENSE" />
    <file src="..\NOTICE" target="NOTICE" />
  </files>
</package>
