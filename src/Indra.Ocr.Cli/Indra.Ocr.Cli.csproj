<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Indra.Ocr.Cli</RootNamespace>
    <AssemblyName>indra-ocr</AssemblyName>
    <!-- The console app ships as a NativeAOT binary (`dotnet publish -c Release -r <rid>`): one
         native executable, no runtime to install. PublishAot turns the AOT/trim analyzers on for
         every build, so the whole pipeline has to stay IL2xxx/IL3xxx-clean — the worker mode
         included (see WorkerPool.WorkerStartInfo). -->
    <PublishAot>true</PublishAot>
    <!-- build/publish.* with INDRA_OCR_FAKE_AOT: the trimmed stand-in for a machine that has no
         platform linker (docs/290-aot.md).  PublishTrimmed is asked for here instead of on the
         command line, because a command-line property reaches the netstandard2.0 target of the
         three libraries as well, and trimming does not exist there (NETSDK1124). -->
    <PublishTrimmed Condition="'$(IndraOcrFakeAot)' == 'true'">true</PublishTrimmed>
    <!-- A host is not a package: it ships as the NativeAOT binaries in the release's per-RID zips
         (build/publish.*), so `dotnet pack` on the solution must skip it. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The CLI is only a front end: Core holds the pipeline, Pdf and Indra.Ocr the two decoders.
       It never touches an image codec or PDFium itself. -->
  <ItemGroup>
    <ProjectReference Include="..\Indra.Ocr.Core\Indra.Ocr.Core.csproj" />
    <ProjectReference Include="..\Indra.Ocr.Pdf\Indra.Ocr.Pdf.csproj" />
    <ProjectReference Include="..\Indra.Ocr\Indra.Ocr.csproj" />
  </ItemGroup>

  <!-- The tests read the CLI's own parser definition and namespace, so the help text and the
       option defaults are checked against the same parser the program uses. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Indra.Ocr.Tests" />
  </ItemGroup>

</Project>
