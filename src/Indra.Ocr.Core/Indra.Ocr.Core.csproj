<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Indra.Ocr</RootNamespace>
    <AssemblyName>Indra.Ocr.Core</AssemblyName>
  </PropertyGroup>

  <!-- No third-party image-codec or PDF dependency: Core consumes handwritten grayscale
       pixels (Indra.Ocr.Imaging.BitmapData) and samples ONNX models. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>

</Project>
