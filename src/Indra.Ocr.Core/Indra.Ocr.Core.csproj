<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Indra.Ocr</RootNamespace>
    <AssemblyName>Indra.Ocr.Core</AssemblyName>
    <!-- Multi-target: net10.0 for the two hosts, netstandard2.0 so the library can be consumed
         from .NET Framework (NuGet).  The shared Directory.Build.props sets TargetFramework to
         net10.0, and the SDK only treats a project as a cross-targeting build when TargetFramework
         is empty (Sdk.targets), so it is cleared here. -->
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <TargetFramework></TargetFramework>
    <!-- A class library: it has to stay NativeAOT- and trim-clean, so the analyzers run on every
         build (IL2xxx / IL3xxx). The two hosts publish with PublishAot, which is what needs it.
         Only for net10.0: netstandard2.0 is not an AOT-capable target and the SDK would warn
         (NETSDK1210) on every build. -->
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net10.0'">true</IsAotCompatible>
  </PropertyGroup>

  <!-- The tests reach two internals: LayoutPost.IsItem (the reference's _ITEM predicate, checked
       on its own the way tests/test_textlayer.py does) and nothing else. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Indra.Ocr.Tests" />
  </ItemGroup>

  <!-- No third-party image-codec or PDF dependency: Core consumes grayscale pixels
       (Indra.Ocr.Imaging.GrayImage) and samples ONNX models. The two decoders (Indra.Ocr for
       image files, Indra.Ocr.Pdf for PDFs) reference Core; Core references neither. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>

  <!-- The .NET Framework half (docs/335-multitarget-netstandard20.md): PolySharp turns the
       modern C# the port is written in into netstandard2.0-compatible source, the packages bring
       the BCL types that arrived after netstandard2.0, and Compat/NetStandard20.cs the handful of
       members a source generator cannot add to an existing BCL type.  Nothing here reaches the
       net10.0 build, so its behaviour (and its byte-for-byte parity) is untouched. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="PolySharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Memory" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" />
    <!-- Core reads the model metadata (ocr_models.json, math_models.json) and the tokenizer
         vocab with System.Text.Json, which is in-box on net10.0 only. -->
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <!-- The compat shims are compiled into every target: the file holds the always-on,
       #if-dispatched helpers (Guard, Bits, MathCompat, ...) as well as the polyfills and
       extensions that only a target below netstandard2.1 needs, each inside its own #if. -->
  <ItemGroup>
    <Compile Include="..\Compat\NetStandard20.cs" Link="Compat\NetStandard20.cs" />
  </ItemGroup>

</Project>
