<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <!-- The product line, read back from the assembly where it is used
         (Indra.Ocr.Cli/ArgumentParsing/ProductAttributes.cs).  The reference prints
         `indra-ocr {__version__}` in both hosts (cli.py:72, viewer.py:609) and the viewer's
         /info reports the same `__version__` (viewer.py:262), so the name is the *product* —
         `indra-ocr` — and not the assembly name, which for the viewer is `indra-ocr-viewer`;
         the version is the Python package's (pyproject.toml, `__init__.py`). -->
    <Product>indra-ocr</Product>
    <Version>1.1.2</Version>
    <!-- The NuGet line (docs/340-nuget-packages.md).  `PackageVersion` is what the three packages
         carry: the parity version above plus the flavor we are publishing.  The major/minor track
         the reference, so a port of a newer upstream release moves them, and only the flavor moves
         between our own pushes; bump it every time, because a version once pushed can never be
         replaced.  `Version` itself is untouched on purpose: the hosts read it back from their
         assembly for the version flag and the viewer's /info, and those are the parity surface. -->
    <PackageFlavor>alpha.2</PackageFlavor>
    <PackageVersion>$(Version)-$(PackageFlavor)</PackageVersion>
    <!-- The informational version is part of the parity surface (the version flag, /info): the
         `+<commit sha>` SourceLink/CI appends to it would break the byte-for-byte match. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <NuGetAuditMode>direct</NuGetAuditMode>
    <!-- SixLabors.ImageSharp 2.1.13 is the last Apache-2.0 release (3.x/4.x are under the
         Six Labors Split License), and it carries advisories that are only fixed in 3.x.
         We accept that knowingly: the port needs a permissive image codec. -->
    <NoWarn>$(NoWarn);NU1902;NU1903;NU1904</NoWarn>
    <!-- NativeAOT/trimming: IL2104 (the trimmer) and IL3053 (ILC) are the per-assembly
         summaries.  SixLabors.ImageSharp 2.1.13 — the last Apache-2.0 release, see
         Directory.Packages.props — is the only assembly that produces them, and with
         -p:TrimmerSingleWarn=false its whole warning set is a single IL2075 in
         ExifTagDescriptionAttribute.GetDescription, reflection over EXIF tag fields: a path the
         port never reaches, because it decodes pixels and reads no metadata.  The summaries
         would also hide another assembly's warnings, so if a new package starts warning, look
         for it with -p:TrimmerSingleWarn=false (docs/290-aot.md). -->
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
    <!-- Invariant globalization: the native binary then needs no ICU (on Linux a self-contained
         one would otherwise depend on it), and it is the honest setting for a port of a Python
         program — the reference formats and parses with no locale at all, and every
         culture-sensitive thing the port does is hand-written to match it (FloatFormat,
         ArgumentNumber, the str.strip/round rules).  It also makes string.Normalize a no-op,
         which is why NFC lives in Core (Text/Nfc.cs, docs/295-invariant-globalization.md); the
         tests and the four harnesses are the check that nothing else drifted. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
