<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Indra.Ocr.Images</RootNamespace>
    <AssemblyName>Indra.Ocr</AssemblyName>
    <!-- Multi-target: net10.0 for the two hosts, netstandard2.0 so the library can be consumed
         from .NET Framework (NuGet).  The shared Directory.Build.props sets TargetFramework to
         net10.0, and the SDK only treats a project as a cross-targeting build when TargetFramework
         is empty (Sdk.targets), so it is cleared here. -->
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <TargetFramework></TargetFramework>
    <!-- A class library: it has to stay NativeAOT- and trim-clean, so the analyzers run on every
         build (IL2xxx / IL3xxx). ImageSharp's own aggregates are suppressed in
         Directory.Build.props.  Only for net10.0: netstandard2.0 is not an AOT-capable target and
         the SDK would warn (NETSDK1210) on every build. -->
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net10.0'">true</IsAotCompatible>
  </PropertyGroup>

  <!-- Packing: see Indra.Ocr.Core.csproj (docs/340-nuget-packages.md).  The manifest is the
       external build/*.nuspec, and only the per-release values and the two names the SDK needs to
       name the .nupkg are set here. -->
  <PropertyGroup>
    <PackageId>Bluefire.Indra.Ocr.Sharp</PackageId>
    <!-- See Indra.Ocr.Core.csproj: the nuspec describes the contents alone, so the SDK's own
         build-output collection has to stay out of it (NU5050 otherwise). -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NuspecFile>$(MSBuildThisFileDirectory)..\..\build\Indra.Ocr.Sharp.nuspec</NuspecFile>
    <NuspecBasePath>$(MSBuildThisFileDirectory)..\..\build</NuspecBasePath>
    <NuspecProperties>packageVersion=$(PackageVersion);configuration=$(Configuration)</NuspecProperties>
  </PropertyGroup>

  <!-- The encoded-image layer: it decodes image files (ImageSharp) to Core's GrayImage and turns
       them into pages with the pipeline. Pdf is a sibling that also references Core; the two
       decoders never reference each other, because both hand Core the same GrayImage. -->
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>

  <!-- The .NET Framework half (docs/335-multitarget-netstandard20.md): PolySharp turns the modern
       C# the port is written in into netstandard2.0-compatible source, System.Memory brings the
       span types, and Unsafe the bit reinterpretation the compat layer needs.  ImageSharp 2.1.13
       has a netstandard2.0 asset of its own.  Nothing here reaches the net10.0 build, so its
       behaviour (and its byte-for-byte parity) is untouched. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="PolySharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Memory" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Indra.Ocr.Core\Indra.Ocr.Core.csproj" />
  </ItemGroup>

  <!-- The compat shims are compiled into every target: the file holds the always-on,
       #if-dispatched helpers (Guard, Bits, MathCompat, ...) as well as the polyfills and
       extensions that only a target below netstandard2.1 needs, each inside its own #if. -->
  <ItemGroup>
    <Compile Include="..\Compat\NetStandard20.cs" Link="Compat\NetStandard20.cs" />
  </ItemGroup>

</Project>
