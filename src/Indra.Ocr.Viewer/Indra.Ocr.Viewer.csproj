<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Indra.Ocr.Viewer</RootNamespace>
    <AssemblyName>indra-ocr-viewer</AssemblyName>
    <!-- The viewer ships as a NativeAOT binary too (`dotnet publish -c Release -r <rid>`). Its
         JSON is source-generated (ViewerJson) and its routes are the minimal API's, so nothing
         in it needs runtime code generation; PublishAot keeps the analyzers honest about that. -->
    <PublishAot>true</PublishAot>
    <!-- build/publish.* with INDRA_OCR_FAKE_AOT: the trimmed stand-in for a machine that has no
         platform linker (docs/290-aot.md).  PublishTrimmed is asked for here instead of on the
         command line, because a command-line property reaches the netstandard2.0 target of the
         three libraries as well, and trimming does not exist there (NETSDK1124). -->
    <PublishTrimmed Condition="'$(IndraOcrFakeAot)' == 'true'">true</PublishTrimmed>
    <!-- A host is not a package: it ships as the NativeAOT binaries in the release's per-RID zips
         (build/publish.*), so `dotnet pack` on the solution must skip it. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The viewer is a front end like the CLI: Core holds the pipeline, Pdf and Indra.Ocr the two
       decoders. It never touches an image codec or PDFium itself. It references the CLI because
       the two hosts share the argument parser and the Python-spelling helpers
       (indra_ocr.viewer imports them from indra_ocr.cli the same way). -->
  <ItemGroup>
    <ProjectReference Include="..\Indra.Ocr.Cli\Indra.Ocr.Cli.csproj" />
    <ProjectReference Include="..\Indra.Ocr.Core\Indra.Ocr.Core.csproj" />
    <ProjectReference Include="..\Indra.Ocr.Pdf\Indra.Ocr.Pdf.csproj" />
    <ProjectReference Include="..\Indra.Ocr\Indra.Ocr.csproj" />
  </ItemGroup>

  <!-- The tests read the viewer's own parser definition, so its help text and its defaults are
       checked against the same parser the program uses. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Indra.Ocr.Tests" />
  </ItemGroup>

</Project>
