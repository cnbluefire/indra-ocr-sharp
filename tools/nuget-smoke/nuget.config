<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The smoke consumes the packages this checkout just packed, so the local feed is the only
       interesting source; nuget.org is kept for their dependencies (ONNX Runtime, PDFium,
       ImageSharp, System.Memory, ...).  <clear/> drops whatever the machine has configured, so a
       run cannot silently pick up a published version of the same id. -->
  <packageSources>
    <clear />
    <add key="local" value="../../temp/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
